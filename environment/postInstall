#!/usr/bin/env bash
# Build-time setup for the MCC / Dovetail capture workflow.
# Base env: alignment and pair-processing tools.
# Separate env: CHiCAGO (its R stack is pinned and kept away from the base python).
set -euo pipefail

MAMBA=/opt/conda/bin/mamba

"$MAMBA" install -y -c conda-forge -c bioconda \
  bwa=0.7.19 \
  samtools=1.24 \
  pairtools=1.1.3 \
  bedtools=2.31.1 \
  mosdepth=0.3.14 \
  tabulate=0.10.0 \
  htslib

"$MAMBA" create -y -n chicago-r -c conda-forge -c bioconda \
  'r-base>=4.3' \
  bioconductor-chicago \
  bioconductor-rsamtools \
  r-argparser \
  r-data.table

"$MAMBA" clean -y --all
